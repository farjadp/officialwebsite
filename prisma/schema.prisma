generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  USER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  bio           String?
  phone         String?
  isActive      Boolean   @default(true)
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  startupIntakes          StartupIntake[]
  bugReports              BugReport[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String? // MDX content
  excerpt     String?
  coverImage  String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  readingTime Int? // in minutes
  views       Int        @default(0)

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  seoKeywords    String? // Comma separated

  seriesId    String?
  series      Series? @relation(fields: [seriesId], references: [id])
  seriesOrder Int? // Order within the series

  // ─── Content engine (CONTENT_ENGINE.md) ───────────────────────────────────
  locale             String  @default("en") // "en" | "fa"
  translationGroupId String? // pairs the en/fa versions of one article
  embedding          Float[] @default([]) // text-embedding-3-small, for the duplicate guard
  contentJobId       String? // provenance: which ContentJob produced this

  // Relations
  categories Category[]
  tags       Tag[]
  topics     Topic[] // Maintaining legacy support for now, but assume migration to Tags

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, status])
  @@index([translationGroupId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String? // Icon name from Lucide
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Series {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  coverImage     String?
  targetAudience String?

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Topic {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  content    String?
  showInMenu Boolean @default(false)
  menuOrder  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id     String   @id @default(cuid())
  email  String   @unique
  tags   String[] // e.g. ["Founder", "SME"]
  source String?

  joinedAt DateTime @default(now())
}

model Media {
  id       String @id @default(cuid())
  filename String
  url      String
  type     String
  size     Int

  createdAt DateTime @default(now())
}

model SocialPublishLog {
  id        String @id @default(cuid())
  postId    String
  postSlug  String
  postTitle String

  // Waterfall analysis
  coreTruth String?
  sentiment String?

  // Platform results
  telegramStatus String  @default("PENDING") // PENDING, SUCCESS, FAILED, SKIPPED
  telegramError  String?
  telegramText   String?

  twitterStatus String  @default("PENDING")
  twitterError  String?
  twitterText   String?

  linkedinStatus String  @default("PENDING")
  linkedinError  String?
  linkedinText   String?
  linkedinHook   String?

  // Sniper Retargeting
  retargetingSegment       String?
  retargetingPainPoint     String?
  retargetingHeadline      String?
  retargetingPrimaryText   String?
  retargetingVisual        String?
  retargetingStoryHook     String?
  retargetingStorySolution String?

  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  toolId    String   @default("unknown")
  score     Int
  segment   String
  answers   Json
  createdAt DateTime @default(now())

  @@unique([email, toolId])
}

model ToolUsage {
  id        String   @id @default(cuid())
  toolId    String
  score     Int
  ip        String?
  country   String?
  createdAt DateTime @default(now())
}

model WebsiteAuditLog {
  id              String   @id @default(cuid())
  requestedUrl    String
  finalUrl        String?
  hostname        String
  status          String // "SUCCESS" | "FAILED"
  overallScore    Int?
  grade           String?
  accessScore     Int?
  metadataScore   Int?
  agentScore      Int?
  citabilityScore Int?
  durationMs      Int
  error           String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([hostname])
  @@index([status])
}

model AIGeneratedAsset {
  id        String   @id @default(cuid())
  type      String // "vault" or "audio"
  topic     String
  content   String // Markdown or Text content
  createdAt DateTime @default(now())
}

model BackupLog {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  status        String // "success" | "failed" | "running"
  type          String // "full" | "db-only" | "code-only"
  dbFile        String? // local path to DB dump file
  codeFile      String? // local path to code zip file
  dbSizeBytes   BigInt?
  codeSizeBytes BigInt?
  durationMs    Int?
  error         String?
  notes         String?
  createdAt     DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String // "info" | "warn" | "error"
  message   String
  source    String? // e.g. "api", "job", "ui"
  path      String?
  method    String?
  status    Int?
  ip        String?
  userAgent String?
  userId    String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  content      String? // Markdown content
  coverImage   String?
  featured     Boolean  @default(false)
  technologies String[] // e.g. ["Next.js", "Tailwind"]
  websiteUrl   String?
  githubUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  role      String?
  content   String
  avatar    String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RouteMetric {
  path      String   @id
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model IntakeInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String?
  isActive  Boolean  @default(true)
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  submissions StartupIntake[]
}

model StartupIntake {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  inviteId    String?
  invite      IntakeInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  startupName String
  website     String?
  country     String
  founders    Json
  answers     Json
  files       Json
  status      String        @default("DRAFT") // "DRAFT" | "SUBMITTED" | "REVIEWED"
  reviewNote  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([createdAt])
}

model MentoredStartup {
  id           String   @id @default(cuid())
  name         String
  industry     String
  satisfaction String
  status       String
  isActive     Boolean  @default(true)
  startDate    String
  endDate      String
  website      String?
  linkedin     String?
  logo         String?
  description  String
  founderName  String
  founderPhoto String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BugReport {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentUrl      String?
  aiGuess         String?
  userDescription String?
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}

// ---------- Book Club (دورهمی کتاب‌خوانی مشروطه) ----------

model BookClubSession {
  id                String   @id @default(cuid())
  title             String
  sessionDate       DateTime
  googleEventId     String?
  meetLink          String?
  readingAssignment String? // چه بخشی برای این جلسه باید خوانده شود
  summary           String? // HTML خلاصه جلسه
  status            String   @default("UPCOMING") // UPCOMING, DONE, CANCELED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sessionDate])
}

model BookClubBook {
  id          String   @id @default(cuid())
  title       String
  author      String?
  description String?
  link        String?
  coverUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model BookClubMember {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  joinedAt DateTime @default(now())
}

model LabApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  telegram   String
  social     String?
  stage      String
  problem    String
  why        String
  deckUrl    String?
  deckName   String?
  status     String   @default("NEW") // "NEW" | "CONTACTED" | "ARCHIVED"
  telegramOk Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Astaneh perk partners — companies offering perks to the Lab's teams.
// Submitted from /fa/lab/perks; the row is the durable record, email is a notification.
model PerkOffer {
  id            String   @id @default(cuid())
  companyName   String
  website       String
  contactName   String
  email         String
  telegram      String?
  country       String
  perkType      String
  description   String
  valueEstimate String?
  markets       String[]
  validity      String?
  consent       Boolean
  status        String   @default("NEW") // "NEW" | "CONTACTED" | "ACCEPTED" | "DECLINED"
  emailOk       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// Email Marketing Suite
// Why: self-hosted campaign engine (contacts, templates, sending, analytics)
// Sending engine: Resend. Mailchimp is import-only.
// ============================================================================

enum ContactStatus {
  PENDING // double opt-in requested, not confirmed yet
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  SUNSET // auto-archived for prolonged disengagement
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  FAILED
}

enum RecipientStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SKIPPED
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  REPLIED
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  MANUAL
  INVALID
}

model Contact {
  id        String        @id @default(cuid())
  email     String        @unique
  firstName String?
  lastName  String?
  company   String?
  locale    String        @default("en") // "en" | "fa" — drives template direction
  status    ContactStatus @default(ACTIVE)
  source    String? // "csv" | "mailchimp" | "lead" | "subscriber" | "form"

  // Custom merge fields available to the editor as {{custom.key}}
  attributes Json @default("{}")

  // Engagement scoring — drives segmentation, send-time and sunset policy
  engagementScore Int       @default(50)
  lastOpenedAt    DateTime?
  lastClickedAt   DateTime?
  lastSentAt      DateTime?
  sendCount       Int       @default(0)
  openCount       Int       @default(0)
  clickCount      Int       @default(0)

  // Best hour (0-23) in UTC derived from open history
  bestSendHour Int?

  confirmedAt  DateTime? // double opt-in confirmation
  confirmToken String?   @unique
  unsubToken   String    @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ContactListMember[]
  recipients  CampaignRecipient[]
  events      EmailEvent[]
  enrollments AutomationEnrollment[]

  @@index([status])
  @@index([engagementScore])
  @@index([createdAt])
}

model ContactList {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String  @default("#7c3aed")

  // Dynamic segment: when set, membership is computed, not stored
  isDynamic Boolean @default(false)
  filter    Json? // { status, tags, engagementMin, openedWithinDays, ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   ContactListMember[]
  campaigns Campaign[]

  @@index([createdAt])
}

model ContactListMember {
  id        String   @id @default(cuid())
  contactId String
  listId    String
  addedAt   DateTime @default(now())

  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([listId])
}

model Suppression {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  detail    String?
  createdAt DateTime          @default(now())

  @@index([reason])
}

model EmailTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String  @default("general") // newsletter | announcement | welcome | promo
  thumbnail   String?

  // Canonical source of truth: ordered block documents
  blocks Json    @default("[]")
  // Global design tokens (colors, fonts, width, direction)
  theme  Json    @default("{}")
  // Compiled email-safe HTML cache
  html   String? @db.Text

  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([category])
}

model Campaign {
  id        String @id @default(cuid())
  name      String
  subject   String @default("")
  preheader String @default("")

  fromName  String  @default("Farjad PMD")
  fromEmail String  @default("")
  replyTo   String?

  status CampaignStatus @default(DRAFT)

  templateId String?
  listId     String?

  // Audience override / refinement on top of the list
  segmentFilter Json?

  blocks Json    @default("[]")
  theme  Json    @default("{}")
  html   String? @db.Text
  text   String? @db.Text

  // A/B testing
  abEnabled         Boolean @default(false)
  abTestPercent     Int     @default(20)
  abWinnerMetric    String  @default("open") // "open" | "click"
  abWinnerVariantId String?

  // Delivery controls
  scheduledAt      DateTime?
  optimizeSendTime Boolean   @default(false)
  throttlePerHour  Int       @default(500)

  // Denormalized analytics counters
  totalRecipients  Int @default(0)
  sentCount        Int @default(0)
  deliveredCount   Int @default(0)
  openCount        Int @default(0)
  uniqueOpenCount  Int @default(0)
  clickCount       Int @default(0)
  uniqueClickCount Int @default(0)
  bounceCount      Int @default(0)
  complaintCount   Int @default(0)
  unsubCount       Int @default(0)

  // AI pre-flight spam audit result
  spamScore  Int?
  spamReport Json?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  template   EmailTemplate?      @relation(fields: [templateId], references: [id])
  list       ContactList?        @relation(fields: [listId], references: [id])
  variants   CampaignVariant[]
  recipients CampaignRecipient[]
  events     EmailEvent[]
  links      CampaignLink[]

  @@index([status])
  @@index([createdAt])
}

model CampaignVariant {
  id         String  @id @default(cuid())
  campaignId String
  label      String // "A" | "B"
  subject    String
  preheader  String  @default("")
  blocks     Json?
  html       String? @db.Text

  sentCount  Int @default(0)
  openCount  Int @default(0)
  clickCount Int @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, label])
}

model CampaignRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  contactId    String
  variantLabel String          @default("A")
  status       RecipientStatus @default(QUEUED)

  providerId String? // Resend message id — links webhooks back
  error      String?

  scheduledFor DateTime?
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([status, scheduledFor])
  @@index([providerId])
}

model CampaignLink {
  id          String  @id @default(cuid())
  campaignId  String
  url         String  @db.Text
  label       String?
  clickCount  Int     @default(0)
  uniqueCount Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EmailEvent {
  id         String         @id @default(cuid())
  type       EmailEventType
  campaignId String?
  contactId  String?
  email      String
  linkUrl    String?        @db.Text
  userAgent  String?
  meta       Json?
  createdAt  DateTime       @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId, type])
  @@index([contactId])
  @@index([createdAt])
}

model Automation {
  id            String  @id @default(cuid())
  name          String
  description   String?
  trigger       String  @default("contact_created") // contact_created | list_joined | no_open_days | tag_added
  triggerConfig Json    @default("{}")
  listId        String?
  isActive      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       AutomationStep[]
  enrollments AutomationEnrollment[]
}

model AutomationStep {
  id           String  @id @default(cuid())
  automationId String
  order        Int
  delayHours   Int     @default(24)
  subject      String  @default("")
  preheader    String  @default("")
  blocks       Json    @default("[]")
  html         String? @db.Text
  // Skip this step if the contact already engaged
  skipIfOpened Boolean @default(false)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, order])
}

model AutomationEnrollment {
  id           String    @id @default(cuid())
  automationId String
  contactId    String
  currentStep  Int       @default(0)
  nextRunAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([automationId, contactId])
  @@index([nextRunAt])
}

model SendingStat {
  id         String   @id @default(cuid())
  day        DateTime @unique @db.Date
  sent       Int      @default(0)
  delivered  Int      @default(0)
  bounced    Int      @default(0)
  complained Int      @default(0)
  // Warm-up ceiling for this day
  dailyCap   Int      @default(50)
}

// ============================================================================
// DMARC aggregate reports
// Why: turn the XML receivers send into an answer to one question —
// is it safe to raise the policy from p=none to p=quarantine yet?
// ============================================================================

model DmarcReport {
  id String @id @default(cuid())

  // Reporter identity — reportId is only unique per organisation
  reportId String
  orgName  String
  orgEmail String?

  domain     String
  rangeBegin DateTime
  rangeEnd   DateTime

  // Policy the receiver actually saw when it evaluated our mail
  policyP   String
  policySp  String?
  policyPct Int?
  adkim     String?
  aspf      String?

  totalMessages Int @default(0)
  passCount     Int @default(0)
  failCount     Int @default(0)

  sourceFile String?
  createdAt  DateTime @default(now())

  records DmarcRecord[]

  @@unique([orgName, reportId])
  @@index([rangeBegin])
}

model DmarcRecord {
  id       String @id @default(cuid())
  reportId String

  sourceIp String
  count    Int    @default(1)

  // What the receiver decided
  disposition String
  dkimPolicy  String
  spfPolicy   String

  headerFrom String?

  // Raw authentication results, which explain WHY the policy evaluated that way
  dkimDomain   String?
  dkimSelector String?
  dkimResult   String?
  spfDomain    String?
  spfResult    String?

  report DmarcReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sourceIp])
}

// ============================================================================
// Content Engine
// Why: a cron-driven pipeline that turns external trend signals into bilingual,
//      reviewed, illustrated articles. Spec: CONTENT_ENGINE.md
// State lives here because one cron tick performs exactly one transition — a
// Vercel function cannot hold the whole chain.
// No Postgres enums: kinds and states are TEXT with the union in a comment,
// following PerkOffer, so a new state is a code change rather than production
// DDL.
// ============================================================================

model ContentSource {
  id    String  @id @default(cuid())
  kind  String // "RSS" | "HN" | "REDDIT" | "URL" | "PDF"
  label String // "Medium · AI", "Lenny's Newsletter"
  url   String? // null only for PDF

  fileUrl String? // blob URL, PDF only
  weight  Int     @default(1) // multiplies a signal's score
  enabled Boolean @default(true)

  // URL and PDF sources are reference material for briefs. They never produce
  // trend signals — a document does not trend.
  isReference Boolean @default(false)

  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  signals ContentSignal[]

  @@index([kind, enabled])
}

model ContentSignal {
  id       String        @id @default(cuid())
  sourceId String
  source   ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // sha256 of the URL with tracking parameters stripped: the same story from
  // two feeds collapses to one row.
  fingerprint String @unique

  title       String
  url         String
  summary     String?
  author      String?
  publishedAt DateTime?
  engagement  Int       @default(0) // upvotes, comments, claps where available
  score       Float     @default(0)
  clusterKey  String? // signals sharing a theme share this
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([used, score])
  @@index([clusterKey])
}

model ContentJob {
  id String @id @default(cuid())

  // SCOUTED BRIEFED DRAFTED SEO_PASS REVIEW REVISING
  // FA_DRAFT FA_REVIEW ART READY PUBLISHED NEEDS_HUMAN FAILED
  state String @default("SCOUTED")

  signalIds String[] @default([]) // the cluster this job came from
  brief     Json?

  enPostId String?
  faPostId String?

  iteration   Int  @default(0) // review loop counter
  attempts    Int  @default(0) // transport failures on the current state
  seoScore    Int?
  reviewScore Int?
  faScore     Int?
  costCents   Int  @default(0)

  // Append-only: { at, state, agent, model, tokens, ms, note }
  trace Json @default("[]")

  error String?

  // 5-minute lease, so overlapping cron invocations are harmless.
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, lockedAt])
}

// ============================================================================
// Job Search
// Why: the owner's private job search — boards to watch, the postings found on
//      them, and where each one stands. Spec:
//      docs/superpowers/specs/2026-10-01-job-search-design.md
// Kinds and states are TEXT with the union in a comment, as above. The career
// profile is one AppSetting row (`jobs.profile`): this repository is public,
// so nothing personal is seeded or committed.
// ============================================================================

model JobBoard {
  id    String @id @default(cuid())
  kind  String // "GREENHOUSE" | "LEVER" | "ASHBY" | "REMOTIVE"
  label String // the company name, or what the search is for
  // The company's slug on its board; for REMOTIVE, the search phrase.
  token String

  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  lastCount     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  postings JobPosting[]

  @@unique([kind, token])
}

model JobPosting {
  id      String   @id @default(cuid())
  boardId String
  board   JobBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // kind:token:externalId — the same posting fetched twice is one row.
  fingerprint String @unique
  externalId  String

  title       String
  company     String
  location    String?
  country     String? // "CA" | "US" | "NA" | "OTHER"; null when it cannot be told
  remote      Boolean   @default(false)
  department  String?
  url         String
  // Plain text, kept only while the posting passes the prefilter.
  description String?
  postedAt    DateTime?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  // Consecutive fetches of its board this posting was absent from.
  missedRuns  Int       @default(0)
  closedAt    DateTime?

  prefilter       String  @default("REJECT") // "PASS" | "REJECT"
  prefilterReason String?
  lane            String?

  score         Int? // 0–100
  // { fit, gaps, authorisation: "OK" | "NEEDS_SPONSORSHIP" | "UNCLEAR" }
  scoreNotes    Json?
  scoredAt      DateTime?
  scoreAttempts Int       @default(0)

  // NEW SHORTLISTED APPLIED INTERVIEW OFFER REJECTED DISMISSED
  status    String    @default("NEW")
  appliedAt DateTime?
  notes     String?

  @@index([prefilter, status, score])
  @@index([boardId, closedAt])
}
